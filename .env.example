# LISA Configuration Environment Variables

# LLM Provider Configuration
NVIDIA_API_KEY=your_nvidia_api_key_here

# GitHub Integration Token (Optional)
GITHUB_TOKEN=

# LISA API Key Authentication (Optional — if unset, endpoints are open in dev mode)
LISA_API_KEY=your_local_api_key_here

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./lisa.db

# Execution Resource Limits
MAX_TEST_STEPS=50
MAX_TEST_TIME=600

# Logging Level
LOG_LEVEL=INFO
